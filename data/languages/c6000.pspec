<?xml version="1.0" encoding="UTF-8"?>
<!-- TMS320C6000 processor specification. -->
<processor_spec>
  <programcounter register="PC"/>
  <!-- Internal decode and scheduler state stays out of normal Listing assumptions.
       Ghidra's Display Hidden Registers option still exposes it for diagnostics. -->
  <register_data>
    <register name="contextreg" hidden="true"/>
    <register name="c_is16" hidden="true"/>
    <register name="c_rs" hidden="true"/>
    <register name="c_dsz" hidden="true"/>
    <register name="c_sat" hidden="true"/>
    <register name="c_br" hidden="true"/>
    <register name="c_prot" hidden="true"/>
    <register name="c_isheader" hidden="true"/>
    <register name="c_branch_terminal" hidden="true"/>
    <register name="c_pfollow" hidden="true"/>
    <register name="c_flow_delay" hidden="true"/>
    <register name="c_schedule_entry" hidden="true"/>
    <register name="c_hdrpkt" hidden="true"/>
    <register name="c_pkt_active" hidden="true"/>
    <register name="c_pkt_start" hidden="true"/>
    <register name="c_pkt_end" hidden="true"/>
    <register name="c_pkt_branch_end" hidden="true"/>
    <register name="c_pkt_chain0" hidden="true"/>
    <register name="c_pkt_chain1" hidden="true"/>
    <register name="c_pkt_write0" hidden="true"/>
    <register name="c_pkt_write1" hidden="true"/>
    <register name="c_pkt_commit0" hidden="true"/>
    <register name="c_pkt_commit1" hidden="true"/>
    <register name="C6000_PIPE_RET" hidden="true"/>
    <register name="C6000_PIPE_ILC" hidden="true"/>
    <register name="C6000_PIPE_RILC" hidden="true"/>
    <register name="C6000_PKT_A0" hidden="true"/>
    <register name="C6000_PKT_A1" hidden="true"/>
    <register name="C6000_PKT_A2" hidden="true"/>
    <register name="C6000_PKT_A3" hidden="true"/>
    <register name="C6000_PKT_A4" hidden="true"/>
    <register name="C6000_PKT_A5" hidden="true"/>
    <register name="C6000_PKT_A6" hidden="true"/>
    <register name="C6000_PKT_A7" hidden="true"/>
    <register name="C6000_PKT_A8" hidden="true"/>
    <register name="C6000_PKT_A9" hidden="true"/>
    <register name="C6000_PKT_A10" hidden="true"/>
    <register name="C6000_PKT_A11" hidden="true"/>
    <register name="C6000_PKT_A12" hidden="true"/>
