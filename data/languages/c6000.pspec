    <register name="C6000_PKT_B1" hidden="true"/>
    <register name="C6000_PKT_B2" hidden="true"/>
    <register name="C6000_PKT_B3" hidden="true"/>
    <register name="C6000_PKT_B4" hidden="true"/>
    <register name="C6000_PKT_B5" hidden="true"/>
    <register name="C6000_PKT_B6" hidden="true"/>
    <register name="C6000_PKT_B7" hidden="true"/>
    <register name="C6000_PKT_B8" hidden="true"/>
    <register name="C6000_PKT_B9" hidden="true"/>
    <register name="C6000_PKT_B10" hidden="true"/>
    <register name="C6000_PKT_B11" hidden="true"/>
    <register name="C6000_PKT_B12" hidden="true"/>
    <register name="C6000_PKT_B13" hidden="true"/>
    <register name="C6000_PKT_B14" hidden="true"/>
