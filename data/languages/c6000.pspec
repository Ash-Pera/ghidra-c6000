    <register name="C6000_PKT_A22" hidden="true"/>
    <register name="C6000_PKT_A23" hidden="true"/>
    <register name="C6000_PKT_A24" hidden="true"/>
    <register name="C6000_PKT_A25" hidden="true"/>
    <register name="C6000_PKT_A26" hidden="true"/>
    <register name="C6000_PKT_A27" hidden="true"/>
    <register name="C6000_PKT_A28" hidden="true"/>
    <register name="C6000_PKT_A29" hidden="true"/>
    <register name="C6000_PKT_A30" hidden="true"/>
    <register name="C6000_PKT_A31" hidden="true"/>
